{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(DemandaId = upper(trim(     iif(isNull(DemandaId) || length(trim(toString(DemandaId))) == 0,          concat('DM-', replace(toString(FechaServicio), '-', ''), '-', RutaHistoricaId, '-', ParadaHistoricaId),         DemandaId     ) )),",
				"          RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          ParadaHistoricaId = upper(trim(ParadaHistoricaId)),",
				"          Franja = upper(trim(Franja)),",
				"          Metodo = upper(trim(     iif(isNull(Metodo) || length(trim(toString(Metodo))) == 0 || toString(Metodo) == 'null',          'NO_ESPECIFICADO',          Metodo     ) ))) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = iif(isNull(FechaServicio) || length(trim(toString(FechaServicio))) == 0, toDate(null()),     iif(instr(toString(FechaServicio), '-') > 0,          toDate(toString(FechaServicio), 'yyyy-MM-dd'),         iif(instr(toString(FechaServicio), '/') > 0,              toDate(toString(FechaServicio), 'dd/MM/yyyy'),             addDays(toDate('1899-12-30'), toInteger(toString(FechaServicio)))         )     ) ),",
				"          ValidacionesTarjeta = iif(isNull(ValidacionesTarjeta), 0, toInteger(ValidacionesTarjeta)),",
				"          Descensos = iif(isNull(Descensos), 0, toInteger(Descensos)),",
				"          DemandaNoAtendida = iif(isNull(DemandaNoAtendida), 0, toInteger(DemandaNoAtendida))) ~> derivedColumn2",
				"derivedColumn2 split(isNull(DemandaId) || length(trim(toString(DemandaId))) == 0 || isNull(FechaServicio) || isNull(RutaHistoricaId) || isNull(ParadaHistoricaId),",
				"     disjoint: false) ~> split1@(rechazados, validos)",
				"split1@validos aggregate(groupBy(DemandaId),",
				"     FechaServicio = first(FechaServicio),",
				"          RutaHistoricaId = first(RutaHistoricaId),",
				"          ParadaHistoricaId = first(ParadaHistoricaId),",
				"          Franja = first(Franja),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          Descensos = first(Descensos),",
				"          DemandaNoAtendida = first(DemandaNoAtendida),",
				"          Metodo = first(Metodo)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}