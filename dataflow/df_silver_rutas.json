{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(RutaHistoricaId = upper(trim(     iif(isNull(RutaHistoricaId) || length(trim(toString(RutaHistoricaId))) == 0,          concat('RH-', lpad(replace(replace(upper(trim(CodigoRuta)), 'RUTA ', ''), 'R-', ''), 2, '0')),         RutaHistoricaId     ) )),",
				"          CodigoRuta = upper(trim(CodigoRuta)),",
				"          NombreRuta = trim(NombreRuta),",
				"          Origen = upper(trim(Origen)),",
				"          Destino = upper(trim(Destino)),",
				"          Estado = upper(trim(Estado))) ~> derivedColumn1",
				"derivedColumn1 derive(VigenciaDesde = iif(isNull(VigenciaDesde) || length(trim(toString(VigenciaDesde))) == 0, toDate(null()),     iif(instr(toString(VigenciaDesde), '-') > 0,          toDate(toString(VigenciaDesde), 'yyyy-MM-dd'),         iif(instr(toString(VigenciaDesde), '/') > 0,              toDate(toString(VigenciaDesde), 'dd/MM/yyyy'),             addDays(toDate('1899-12-30'), toInteger(toString(VigenciaDesde)))         )     ) ),",
				"          VigenciaHasta = iif(isNull(VigenciaHasta) || length(trim(toString(VigenciaHasta))) == 0, toDate(null()),     iif(instr(toString(VigenciaHasta), '-') > 0,          toDate(toString(VigenciaHasta), 'yyyy-MM-dd'),         iif(instr(toString(VigenciaHasta), '/') > 0,              toDate(toString(VigenciaHasta), 'dd/MM/yyyy'),             addDays(toDate('1899-12-30'), toInteger(VigenciaHasta))         )     ) )) ~> derivedColumn2",
				"derivedColumn2 split(isNull(RutaHistoricaId) || length(trim(toString(RutaHistoricaId))) == 0 || isNull(CodigoRuta) || isNull(VigenciaDesde),",
				"     disjoint: false) ~> split1@(rechazados, validos)",
				"split1@validos aggregate(groupBy(RutaHistoricaId),",
				"     CodigoRuta = first(CodigoRuta),",
				"          NombreRuta = first(NombreRuta),",
				"          Origen = first(Origen),",
				"          Destino = first(Destino),",
				"          VigenciaDesde = first(VigenciaDesde),",
				"          VigenciaHasta = first(VigenciaHasta),",
				"          Estado = first(Estado)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}